@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <div class="app-container">
            <div class="sidebar @(sidebarCollapsed ? "sidebar-collapsed" : "")">
                <NavMenu Collapsed="sidebarCollapsed" OnToggleRequested="ToggleSidebar" />
            </div>

            <main class="main-content">
                <div class="topbar">
                    <div class="page-title">
                        Gestión Veterinaria
                    </div>
                    
                    <div class="user-profile" style="display: flex; align-items: center; gap: 10px;">
                        <a href="/perfil" style="display: flex; align-items: center; gap: 10px; text-decoration: none; cursor: pointer; padding: 4px 8px; border-radius: 8px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background='transparent'">
                            <div style="text-align: right; line-height: 1.2;">
                                <span style="color: var(--text-primary); font-weight: 600; font-size: 0.9rem;">@context.User.Identity?.Name</span>
                                <br/>
                                <span style="color: var(--accent-primary); font-size: 0.75rem; font-weight: 500;">@GetUserRole(context)</span>
                            </div>
                            <div class="avatar" style="width: 36px; height: 36px; border-radius: 50%; background: var(--accent-primary); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 0.9rem;">
                                @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                        </a>
                        <button class="btn btn-sm btn-outline-danger" style="font-size: 0.8rem; padding: 4px 12px;" @onclick="Logout">
                            Cerrar Sesión
                        </button>
                    </div>
                </div>

                <article class="content-area">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
    <Authorizing>
        <div style="position: fixed; inset: 0; background-color: #2e7d32; z-index: 9999; display: flex; align-items: center; justify-content: center; color: white; font-family: 'Poppins', sans-serif;">
            <div style="text-align: center;">
                <div class="spinner-border text-light mb-3" role="status"></div>
                <h4>Verificando sesión...</h4>
            </div>
        </div>
    </Authorizing>
    <NotAuthorized>
        <div style="position: fixed; inset: 0; background-color: #2e7d32; z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; color: white; font-family: 'Poppins', sans-serif; text-align: center; padding: 20px;">
            <div style="background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.2); padding: 40px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); max-width: 450px; width: 90%;">
                <div style="font-size: 4rem; margin-bottom: 20px;">🔒</div>
                <h2 style="font-weight: 700; margin-bottom: 10px; font-size: 1.8rem;">Acceso Restringido</h2>
                <p style="font-size: 1.1rem; opacity: 0.9; margin-bottom: 20px;">Debes iniciar sesión para acceder al sistema.</p>
                <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.1); padding: 8px 16px; border-radius: 20px; font-size: 0.9rem;">
                    <div class="spinner-border spinner-border-sm text-light" role="status" style="width: 1rem; height: 1rem;"></div>
                    <span>Redirigiendo a pantalla de inicio...</span>
                </div>
            </div>
        </div>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error.
    <a href="/login" class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private Blazored.LocalStorage.ILocalStorageService LocalStorage { get; set; } = default!;
    [Inject] private Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private BlazorFrontEnd.Auth.TokenStorageService TokenStorage { get; set; } = default!;

    private bool sidebarCollapsed = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Sync token from localStorage to in-memory TokenStorageService.
            try
            {
                var token = await LocalStorage.GetItemAsync<string>("authToken");
                if (!string.IsNullOrWhiteSpace(token))
                {
                    TokenStorage.SetToken(token);
                }
            }
            catch { /* localStorage not available yet */ }
        }
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    private async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        TokenStorage.ClearToken();
        ((BlazorFrontEnd.Auth.CustomAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
        Navigation.NavigateTo("/", true);
    }

    private string GetUserRole(Microsoft.AspNetCore.Components.Authorization.AuthenticationState context)
    {
        var roleClaim = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)
            ?? context.User.FindFirst("role");
        return roleClaim?.Value ?? "Usuario";
    }
}
