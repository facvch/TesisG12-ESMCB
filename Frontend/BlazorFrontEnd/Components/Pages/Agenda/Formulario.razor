@page "/agenda/editar/{Id}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Veterinario,Recepcionista")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@implements IDisposable
@inject BlazorFrontEnd.Auth.TokenStorageService TokenStorage
@inject TurnoService TurnoService
@inject PacienteService PacienteService
@inject PersonalService PersonalService
@inject CatalogoServiciosService ServiciosService
@inject NavigationManager Navigation

<PageTitle>@(isEdit ? "Editar / Visor Turno" : "Nuevo Turno")</PageTitle>

<div class="d-flex align-items-center" style="margin-bottom: var(--sp-lg);">
    <button class="btn btn-link" style="color: var(--text-secondary); padding: 0; margin-right: 15px;" @onclick="GoBack">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 24px; height: 24px;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
    </button>
    <h2 style="font-weight: 700; margin: 0;">@(isEdit ? "Detalle del Turno" : "Asignación de Turno")</h2>
</div>

<div class="glass-card" style="max-width: 1050px;">
    @if (isLoading)
    {
        <p class="text-secondary">Cargando disponibilidad y pacientes...</p>
    }
    else
    {
        <div class="row g-3 align-items-stretch">
            <!-- 2/3 ancho: Formulario -->
            <div class="col-lg-8">
                <EditForm Model="model" OnValidSubmit="HandleSave" FormName="turnoForm">
                    <DataAnnotationsValidator />
                    
                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Paciente (*)</label>
                            <div class="d-flex gap-2">
                                <SearchableSelect TValue="string"
                                                  @bind-Value="model.PacienteId"
                                                  Options="@pacientesOptions"
                                                  Placeholder="-- Seleccione un Paciente --" />
                                @if (!isEdit)
                                {
                                    <a href="/pacientes/nuevo" class="btn btn-outline-info d-flex align-items-center" style="white-space: nowrap; border-color: var(--border-glass); color: var(--accent-primary);" title="Registrar nuevo paciente">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                        </svg>
                                        Nuevo
                                    </a>
                                }
                            </div>
                            <ValidationMessage For="@(() => model.PacienteId)" class="text-danger" />
                        </div>
                        
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Veterinario Asignado (*)</label>
                            <SearchableSelect TValue="string"
                                              Value="@model.VeterinarioId"
                                              ValueChanged="@OnVeterinarioChanged"
                                              Options="@veterinariosOptions"
                                              Placeholder="-- Médico Veterinario --" />
                            <ValidationMessage For="@(() => model.VeterinarioId)" class="text-danger" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Tipo de Servicio (*)</label>
                            <SearchableSelect TValue="int"
                                              @bind-Value="model.ServicioId"
                                              Options="@serviciosOptions"
                                              Placeholder="-- Servicio Clínico --" />
                            <ValidationMessage For="@(() => model.ServicioId)" class="text-danger" />
                        </div>
                        
                        <div class="col-md-4" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Fecha y Hora Programada (*)</label>
                            <input type="datetime-local" @bind="model.FechaHora" @bind:after="OnFechaHoraChanged" class="form-control bg-dark text-light border-secondary" />
                            @if (!string.IsNullOrEmpty(fechaHoraError))
                            { <div class="text-danger" style="font-size: 0.8rem; margin-top: 4px;">@fechaHoraError</div> }
                        </div>

                        <div class="col-md-4" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Estado Operativo</label>
                            <InputSelect @bind-Value="model.Estado" class="form-select bg-dark text-light border-secondary">
                                <option value="Programado">Programado</option>
                                <option value="Completado">Completado</option>
                                <option value="Ausente">Ausente</option>
                                <option value="Cancelado">Cancelado</option>
                                <option value="Reprogramado">Reprogramado</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Motivo del Turno (*)</label>
                            <InputText @bind-Value="model.Motivo" class="form-control bg-dark text-light border-secondary" placeholder="Ej: Control general anual, Vacuna Sextuple" />
                            <ValidationMessage For="@(() => model.Motivo)" class="text-danger" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Observaciones Previas / Receta</label>
                            <InputTextArea @bind-Value="model.Observaciones" class="form-control bg-dark text-light border-secondary" rows="3" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                            @errorMessage
                        </div>
                    }

                    <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                        <button type="button" class="btn btn-outline-secondary text-light" @onclick="GoBack">Retornar a Agenda</button>
                        <button type="submit" class="btn-primary-glass" disabled="@isSaving">
                            @if(isSaving) { <span>Guardando Turno...</span> } else { <span>Confirmar Turno</span> }
                        </button>
                    </div>
                </EditForm>
            </div>

            <!-- 1/3 ancho: Panel Lateral de Horarios del Veterinario -->
            <div class="col-lg-4">
                <div class="p-3 rounded h-100 d-flex flex-column" style="background: #FAFAFA !important; color: #333333 !important; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom" style="border-color: #e2e8f0 !important;">
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size: 1.1rem;">🗓️</span>
                            <h5 class="m-0 fw-bold" style="font-size: 0.92rem; color: #0284c7;">
                                Horarios de Atención
                            </h5>
                        </div>
                        @if (selectedVetForModel != null)
                        {
                            <div class="d-flex align-items-center gap-1">
                                <button type="button" class="btn btn-sm p-0 px-1 border-0" style="color: #64748b; font-size: 0.75rem; background: transparent; cursor: pointer;" @onclick="PrevWeekHorarios" title="Semana anterior">◀</button>
                                <span style="font-size: 0.72rem; color: #475569; font-weight: 600;">@GetSemanaLabel()</span>
                                <button type="button" class="btn btn-sm p-0 px-1 border-0" style="color: #64748b; font-size: 0.75rem; background: transparent; cursor: pointer;" @onclick="NextWeekHorarios" title="Semana siguiente">▶</button>
                            </div>
                        }
                    </div>

                    @if (selectedVetForModel != null)
                    {
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="small fw-bold" style="color: #333333;">
                                 👨‍⚕️ @selectedVetForModel.NombreCompleto
                            </div>
                            @if (isLoadingVetTurnos)
                            {
                                <span class="spinner-border spinner-border-sm text-primary" role="status" style="width: 14px; height: 14px;"></span>
                            }
                        </div>
                        <div class="d-flex flex-column gap-2 overflow-auto flex-grow-1 pe-1" style="max-height: 420px;">
                            @for (int dia = 1; dia <= 7; dia++)
                            {
                                var diaLocal = dia;
                                var diaNombre = GetDiaNombre(diaLocal);
                                var diaFecha = CurrentWeekMonday.AddDays(diaLocal - 1);
                                var horariosDia = selectedVetForModel.Horarios?.Where(h => h.Activo && h.DiaSemana == diaLocal).ToList();
                                var turnosDia = vetTurnosSemana?.Where(t => t.FechaHora.Date == diaFecha.Date && !string.Equals(t.Estado, "Cancelado", StringComparison.OrdinalIgnoreCase) && (string.IsNullOrEmpty(model.Id) || t.Id != model.Id)).OrderBy(t => t.FechaHora).ToList() ?? new List<TurnoDto>();
                                bool hasHorarios = horariosDia != null && horariosDia.Any();
                                bool isSelectedDate = model.FechaHora.Date == diaFecha.Date;
                                bool isExpanded = IsDiaExpanded(diaLocal);

                                <div class="d-flex flex-column">
                                    <div class="p-2 rounded" 
                                         style="background: @(isSelectedDate ? "#f0f9ff" : "#ffffff"); border: 1px solid @(isSelectedDate ? "#0284c7" : "#e2e8f0"); border-left: 3px solid @(hasHorarios ? "#0284c7" : "#cbd5e1"); font-size: 0.78rem; color: #333333; @(hasHorarios ? "cursor: pointer; user-select: none;" : "")"
                                         @onclick="() => { if (hasHorarios) ToggleDiaExpanded(diaLocal); }"
                                         title="@(hasHorarios ? (isExpanded ? "Click para ocultar turnos agendados" : "Click para ver turnos agendados") : "")">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <strong style="color: #333333;">@diaNombre (@diaFecha.ToString("dd/MM")):</strong>
                                                @if (!hasHorarios)
                                                {
                                                    <span style="color: #64748b; font-style: italic;" class="ms-1">Sin atención</span>
                                                }
                                                else
                                                {
                                                    @foreach (var h in horariosDia!)
                                                    {
                                                        <span style="color: #333333;" class="ms-1">@FormatHorarioText(h)</span>
                                                    }
                                                }
                                            </div>
                                            @if (hasHorarios)
                                            {
                                                <div class="d-flex align-items-center gap-1">
                                                    @if (turnosDia.Any())
                                                    {
                                                        <span class="badge" style="background: #ef4444; color: #ffffff; font-size: 0.68rem; font-weight: 600; padding: 2px 6px;">
                                                            @turnosDia.Count @(turnosDia.Count == 1 ? "turno" : "turnos")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge" style="background: #10b981; color: #ffffff; font-size: 0.68rem; font-weight: 600; padding: 2px 6px;">
                                                            Libre
                                                        </span>
                                                    }
                                                    <span style="color: #64748b; font-size: 0.65rem; line-height: 1;">@(isExpanded ? "▲" : "▼")</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @* Subpestaña corrida a la derecha: turnos agendados del día *@
                                    @if (hasHorarios && isExpanded)
                                    {
                                        <div style="margin-left: 14px; margin-top: 4px; margin-bottom: 4px; display: flex; flex-direction: column; gap: 4px;">
                                            @if (turnosDia.Any())
                                            {
                                                @foreach (var t in turnosDia)
                                                {
                                                    var inicio = t.FechaHora.ToString("HH:mm");
                                                    var finDt = t.FechaHoraFin != default && t.FechaHoraFin > t.FechaHora 
                                                        ? t.FechaHoraFin 
                                                        : t.FechaHora.AddMinutes(t.DuracionMinutos > 0 ? t.DuracionMinutos : 30);
                                                    var fin = finDt.ToString("HH:mm");

                                                    <div class="p-2 rounded" style="background: #fff5f5; border: 1px solid #fca5a5; border-left: 4px solid #ef4444; font-size: 0.75rem; color: #991b1b; box-shadow: 0 1px 2px rgba(239, 68, 68, 0.05);">
                                                        <div class="d-flex align-items-center justify-content-between">
                                                            <span style="font-weight: 600;">
                                                                🚫 Tiene turno entre: @inicio y @fin
                                                            </span>
                                                            <span class="badge bg-danger text-light" style="font-size: 0.65rem;">@t.Estado</span>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(t.PacienteNombre) || !string.IsNullOrEmpty(t.ServicioNombre))
                                                        {
                                                            <div class="mt-1" style="font-size: 0.72rem; color: #7f1d1d;">
                                                                🐾 <strong>@(string.IsNullOrEmpty(t.PacienteNombre) ? "Paciente" : t.PacienteNombre)</strong>
                                                                @(!string.IsNullOrEmpty(t.ServicioNombre) ? $" • {t.ServicioNombre}" : "")
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="p-2 rounded" style="background: #f0fdf4; border: 1px solid #86efac; border-left: 4px solid #10b981; font-size: 0.73rem; color: #166534;">
                                                    ✓ Sin turnos agendados en este día (Completamente disponible)
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-3" style="font-size: 0.85rem; min-height: 220px; color: #475569;">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 38px; height: 38px; margin-bottom: 10px; opacity: 0.7; color: #475569;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                            </svg>
                            Seleccione un médico veterinario para ver sus días y horarios de atención disponibles.
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    private TurnoDto model = new();
    private bool isEdit => !string.IsNullOrEmpty(Id);
    private bool isLoading = true;
    private bool isSaving;
    private string errorMessage = string.Empty;
    private string fechaHoraError = string.Empty;

    private List<PacienteDto> pacientes = new();
    private List<VeterinarioDto> veterinarios = new();
    private List<ServicioDto> servicios = new();

    private IEnumerable<SearchableOption<string>> pacientesOptions =>
        pacientes.Select(p => new SearchableOption<string>
        {
            Value = p.Id,
            Text = p.Nombre,
            Subtext = !string.IsNullOrEmpty(p.PropietarioNombre)
                ? $"Dueño: {p.PropietarioNombre} • {p.EspecieNombre}"
                : p.EspecieNombre,
            ExtraKeywords = $"{p.Nombre} {p.PropietarioNombre} {p.EspecieNombre}"
        });

    private IEnumerable<SearchableOption<string>> veterinariosOptions =>
        veterinarios.Select(v => new SearchableOption<string>
        {
            Value = v.Id,
            Text = v.NombreCompleto,
            Subtext = $"{v.Especialidad} {(!string.IsNullOrEmpty(v.SucursalNombre) ? $"({v.SucursalNombre})" : "")}".Trim(),
            ExtraKeywords = $"{v.NombreCompleto} {v.Especialidad} {v.SucursalNombre}"
        });

    private IEnumerable<SearchableOption<int>> serviciosOptions =>
        servicios.Select(s => new SearchableOption<int>
        {
            Value = s.Id,
            Text = s.Nombre,
            Subtext = $"${s.Precio:N0} • {s.DuracionMinutos} min",
            ExtraKeywords = $"{s.Nombre} {s.Descripcion}"
        });

    private VeterinarioDto? selectedVetForModel =>
        veterinarios?.FirstOrDefault(v => v.Id == model.VeterinarioId);

    // Turnos ocupados del veterinario
    private List<TurnoDto>? vetTurnosSemana;
    private bool isLoadingVetTurnos;
    private DateTime currentSemanaBase = DateTime.Today;
    private HashSet<int> expandedDias = new();

    private DateTime CurrentWeekMonday
    {
        get
        {
            DateTime baseDate = currentSemanaBase != default ? currentSemanaBase.Date : DateTime.Today;
            int diff = ((int)baseDate.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
            return baseDate.AddDays(-diff);
        }
    }

    private string GetSemanaLabel()
    {
        var mon = CurrentWeekMonday;
        var sun = mon.AddDays(6);
        return $"{mon:dd/MM} - {sun:dd/MM}";
    }

    private async Task PrevWeekHorarios()
    {
        currentSemanaBase = currentSemanaBase.AddDays(-7);
        await CargarTurnosVeterinario();
    }

    private async Task NextWeekHorarios()
    {
        currentSemanaBase = currentSemanaBase.AddDays(7);
        await CargarTurnosVeterinario();
    }

    private bool IsDiaExpanded(int dia) => expandedDias.Contains(dia);

    private void ToggleDiaExpanded(int dia)
    {
        if (expandedDias.Contains(dia))
            expandedDias.Remove(dia);
        else
            expandedDias.Add(dia);
    }

    private async Task OnVeterinarioChanged(string val)
    {
        model.VeterinarioId = val;
        await CargarTurnosVeterinario();
    }

    private async Task OnFechaHoraChanged()
    {
        if (model.FechaHora != default)
        {
            currentSemanaBase = model.FechaHora.Date;
            await CargarTurnosVeterinario();
        }
    }

    private async Task CargarTurnosVeterinario()
    {
        if (string.IsNullOrWhiteSpace(model.VeterinarioId))
        {
            vetTurnosSemana = null;
            return;
        }

        isLoadingVetTurnos = true;
        StateHasChanged();
        try
        {
            var mon = CurrentWeekMonday;
            var sun = mon.AddDays(7).AddSeconds(-1);
            var turnos = await TurnoService.GetByVeterinarioAsync(model.VeterinarioId, mon, sun);
            vetTurnosSemana = turnos ?? new List<TurnoDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar turnos del veterinario: {ex.Message}");
            vetTurnosSemana = new List<TurnoDto>();
        }
        finally
        {
            isLoadingVetTurnos = false;
            StateHasChanged();
        }
    }

    private string GetDiaNombre(int dia) => dia switch
    {
        1 => "Lunes",
        2 => "Martes",
        3 => "Miércoles",
        4 => "Jueves",
        5 => "Viernes",
        6 => "Sábado",
        7 => "Domingo",
        _ => ""
    };

    private string FormatHorarioText(HorarioDto h)
    {
        string inicioStr = h.HoraInicio;
        string finStr = h.HoraFin;

        if (TimeSpan.TryParse(h.HoraInicio, out var tsStart))
        {
            var dtStart = DateTime.Today.Add(tsStart);
            inicioStr = dtStart.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture).ToLower();
        }

        if (TimeSpan.TryParse(h.HoraFin, out var tsEnd))
        {
            var dtEnd = DateTime.Today.Add(tsEnd);
            finStr = dtEnd.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture).ToLower();
        }

        bool isGuardia = h.TipoHorarioId == 2 || string.Equals(h.TipoHorarioNombre, "Guardia", StringComparison.OrdinalIgnoreCase);
        string tipoStr = isGuardia ? "Turno guardia" : "Turno normal";

        return $"{inicioStr} a {finStr} | {tipoStr}";
    }

    private DateTime? originalFechaHora;

    protected override async Task OnInitializedAsync()
    {
        TokenStorage.OnContextChanged += HandleContextChanged;
        isLoading = true;
        try
        {
            var resP = await PacienteService.GetAllAsync(1, 1000, "");
            if(resP != null) pacientes = resP.Items;

            var resV = await PersonalService.GetVeterinariosActivosAsync();
            if(resV != null)
            {
                veterinarios = resV
                    .Where(v => !TokenStorage.ActiveSucursalId.HasValue || v.SucursalId == TokenStorage.ActiveSucursalId.Value || (isEdit && v.Id == model.VeterinarioId))
                    .ToList();
            }

            var resS = await ServiciosService.GetServiciosActivosAsync();
            if(resS != null) servicios = resS;

            if (isEdit)
            {
                var response = await TurnoService.GetByIdAsync(Id!);
                if (response != null)
                {
                    model = response;
                    originalFechaHora = response.FechaHora;
                }
                else errorMessage = "No se encontró el turno solicitado.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Error al cargar paramétricas o turno de la base de datos.";
        }
        finally
        {
            isLoading = false;
        }

        if (model.FechaHora != default)
        {
            currentSemanaBase = model.FechaHora.Date;
        }
        if (!string.IsNullOrEmpty(model.VeterinarioId))
        {
            await CargarTurnosVeterinario();
        }
    }

    private async Task HandleSave()
    {
        isSaving = true;
        errorMessage = string.Empty;
        fechaHoraError = string.Empty;

        // Validación custom: los turnos se deben agendar con al menos 30 minutos de anticipación
        if (!isEdit && model.FechaHora < DateTime.Now.AddMinutes(30))
        {
            fechaHoraError = "Los turnos deben agendarse con al menos 30 minutos de anticipación.";
            isSaving = false;
            return;
        }

        // Si se cambia la fecha de un turno existente y no se especificó un estado de cierre/ausente, se marca como Reprogramado
        if (isEdit && originalFechaHora.HasValue && originalFechaHora.Value != model.FechaHora && model.Estado != "Completado" && model.Estado != "Cancelado" && model.Estado != "Ausente")
        {
            model.Estado = "Reprogramado";
        }

        try
        {
            bool result;
            string serverMsg = string.Empty;

            if (isEdit)
            {
                var resUpdate = await TurnoService.UpdateWithResultAsync(Id!, model);
                result = resUpdate.Success;
                serverMsg = resUpdate.ErrorMessage;
            }
            else
            {
                var resCreate = await TurnoService.CreateWithResultAsync(model);
                result = resCreate.Success;
                serverMsg = resCreate.ErrorMessage;
            }

            if (result)
            {
                if (model.Estado == "Completado")
                {
                    Navigation.NavigateTo($"/ventas/pos?servicioId={model.ServicioId}&pacienteId={model.PacienteId}&turnoId={model.Id}");
                }
                else
                {
                    Navigation.NavigateTo("/agenda");
                }
            }
            else
            {
                errorMessage = !string.IsNullOrEmpty(serverMsg) ? serverMsg : "Ya hay un turno registrado en la fecha/hora ingresada para el mismo veterinario o error al guardar.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Excepción al enviar datos del turno.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/agenda");

    private async void HandleContextChanged()
    {
        await InvokeAsync(async () =>
        {
            var resV = await PersonalService.GetVeterinariosActivosAsync();
            if(resV != null)
            {
                veterinarios = resV
                    .Where(v => !TokenStorage.ActiveSucursalId.HasValue || v.SucursalId == TokenStorage.ActiveSucursalId.Value || (isEdit && v.Id == model.VeterinarioId))
                    .ToList();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TokenStorage.OnContextChanged -= HandleContextChanged;
    }
}
