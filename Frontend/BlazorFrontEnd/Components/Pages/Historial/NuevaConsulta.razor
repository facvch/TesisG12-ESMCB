@page "/historial-clinico/nueva-consulta/{PacienteId}"
@page "/historial-clinico/editar-consulta/{PacienteId}/{ConsultaId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Veterinario")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject HistorialClinicoService HistorialService
@inject PacienteService PacienteService
@inject PersonalService PersonalService
@inject NavigationManager Navigation

<PageTitle>@(isEdit ? "Editar Consulta" : "Registrar Consulta") - Historial Clínico</PageTitle>

<div class="glass-card" style="max-width: 800px; margin: auto; margin-top:20px;">
    <h4>@(isEdit ? "Editar Consulta" : "Nueva Consulta") (@pacienteNombre)</h4>
    <hr class="border-secondary" />

    @if (editContext != null)
    {
        <EditForm EditContext="editContext" OnSubmit="HandleSave">
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <label>Fecha (*)</label>
                    <InputDate @bind-Value="model.Fecha" class="form-control bg-dark text-light border-secondary" />
                    <ValidationMessage For="@(() => model.Fecha)" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label>Veterinario Tratante (*)</label>
                    <InputSelect @bind-Value="model.Veterinario" class="form-select bg-dark text-light border-secondary">
                        <option value="">Seleccione...</option>
                        @foreach (var v in vets)
                        {
                            <option value="@v.NombreCompleto">@v.NombreCompleto</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => model.Veterinario)" class="text-danger" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label>Peso (kg) (*)</label>
                    <InputNumber @bind-Value="model.Peso" class="form-control bg-dark text-light border-secondary" TValue="decimal?" />
                    <ValidationMessage For="@(() => model.Peso)" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label>Temp (°C)</label>
                    <InputNumber @bind-Value="model.Temperatura" class="form-control bg-dark text-light border-secondary" TValue="decimal?" />
                    <ValidationMessage For="@(() => model.Temperatura)" class="text-danger" />
                </div>
            </div>

            <div class="mb-3">
                <label>Motivo de Consulta (*)</label>
                <InputText @bind-Value="model.Motivo" class="form-control bg-dark text-light border-secondary" />
                <ValidationMessage For="@(() => model.Motivo)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label>Síntomas reportados (*)</label>
                <InputTextArea @bind-Value="model.Sintomas" class="form-control bg-dark text-light border-secondary" rows="2" />
                <ValidationMessage For="@(() => model.Sintomas)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label>Diagnóstico (Presuntivo o Definitivo) (*)</label>
                <InputTextArea @bind-Value="model.Diagnostico" class="form-control bg-dark text-light border-secondary" rows="2" />
                <ValidationMessage For="@(() => model.Diagnostico)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label>Indicaciones al Propietario (*)</label>
                <InputTextArea @bind-Value="model.Indicaciones" class="form-control bg-dark text-light border-secondary" rows="3" />
                <ValidationMessage For="@(() => model.Indicaciones)" class="text-danger" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger p-2 mt-2">@errorMessage</div>
            }

            <div class="d-flex justify-content-end mt-4 gap-2">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="GoBack">Cancelar</button>
                <button type="submit" class="btn-primary-glass" disabled="@isSaving">@(isEdit ? "Guardar Cambios" : "Guardar Consulta")</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public string PacienteId { get; set; } = string.Empty;

    [Parameter]
    public string? ConsultaId { get; set; }

    private bool isEdit => !string.IsNullOrEmpty(ConsultaId);

    private HistorialClinicoDto model = new() { Fecha = DateTime.Today };
    private string pacienteNombre = "Cargando...";
    private bool isSaving;
    private string errorMessage = string.Empty;
    private List<VeterinarioDto> vets = new();

    private EditContext? editContext;
    private ValidationMessageStore? messageStore;

    protected override async Task OnInitializedAsync()
    {
        model.PacienteId = PacienteId;
        
        var p = await PacienteService.GetByIdAsync(PacienteId);
        if(p != null) {
            pacienteNombre = p.Nombre;
            model.PacienteNombre = p.Nombre;
        }

        var vRes = await PersonalService.GetVeterinariosActivosAsync();
        if(vRes != null) vets = vRes;

        if (isEdit)
        {
            var existing = await HistorialService.GetByIdAsync(ConsultaId!);
            if (existing != null)
            {
                model = existing;
            }
            else
            {
                errorMessage = "No se encontró la consulta a editar.";
            }
        }

        editContext = new EditContext(model);
        messageStore = new ValidationMessageStore(editContext);
        editContext.OnFieldChanged += HandleFieldChanged;
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        messageStore?.Clear(e.FieldIdentifier);
    }

    private async Task HandleSave()
    {
        isSaving = true;
        errorMessage = string.Empty;
        messageStore?.Clear();
        bool hasErrors = false;

        if (model.Fecha == null)
        {
            messageStore?.Add(() => model.Fecha!, "La fecha es obligatoria");
            hasErrors = true;
        }
        else if (model.Fecha.Value.Date > DateTime.Today)
        {
            messageStore?.Add(() => model.Fecha!, "Las consultas ya deben haber sido realizadas");
            hasErrors = true;
        }

        if (string.IsNullOrWhiteSpace(model.Veterinario))
        {
            messageStore?.Add(() => model.Veterinario, "Seleccionar un veterinario es obligatorio");
            hasErrors = true;
        }

        if (model.Peso == null)
        {
            messageStore?.Add(() => model.Peso!, "Ingresar el peso de la mascota es obligatorio");
            hasErrors = true;
        }
        else if (model.Peso < 0)
        {
            messageStore?.Add(() => model.Peso!, "No se puede ingresar un peso negativo");
            hasErrors = true;
        }

        if (string.IsNullOrWhiteSpace(model.Motivo))
        {
            messageStore?.Add(() => model.Motivo, "El motivo de consulta es obligatorio");
            hasErrors = true;
        }

        if (string.IsNullOrWhiteSpace(model.Sintomas))
        {
            messageStore?.Add(() => model.Sintomas, "Los síntomas reportados son obligatorios");
            hasErrors = true;
        }

        if (string.IsNullOrWhiteSpace(model.Diagnostico))
        {
            messageStore?.Add(() => model.Diagnostico, "El diagnóstico es obligatorio");
            hasErrors = true;
        }

        if (string.IsNullOrWhiteSpace(model.Indicaciones))
        {
            messageStore?.Add(() => model.Indicaciones, "Las indicaciones al propietario son obligatorias");
            hasErrors = true;
        }

        editContext?.NotifyValidationStateChanged();

        if (hasErrors)
        {
            isSaving = false;
            return;
        }

        try
        {
            bool success;
            if (isEdit)
            {
                success = await HistorialService.UpdateAsync(ConsultaId!, model);
            }
            else
            {
                success = await HistorialService.CreateAsync(model);
            }

            if (success)
            {
                GoBack();
            }
            else
            {
                errorMessage = isEdit ? "Error al intentar actualizar la consulta." : "Error al intentar guardar la consulta.";
                isSaving = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió una excepción: {ex.Message}";
            isSaving = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo($"/historial-clinico/paciente/{PacienteId}");

    public void Dispose()
    {
        if (editContext != null)
        {
            editContext.OnFieldChanged -= HandleFieldChanged;
        }
    }
}
