@page "/pacientes"
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject PacienteService PacienteService
@inject PropietarioService PropietarioService
@inject CatalogoService CatalogoService
@inject NavigationManager Navigation

<PageTitle>Mascotas / Pacientes</PageTitle>

<div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
    <div>
        <h2 style="font-weight: 700; margin: 0;">Registro de Pacientes</h2>
        <p class="text-secondary" style="margin: 0;">Gestión de mascotas y su historial clínico</p>
    </div>
    <button @onclick="OpenPacienteModal" class="btn-primary-glass" style="display: flex; align-items: center; gap: 8px; border: none; cursor: pointer;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 20px;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nuevo Paciente
    </button>
</div>

<div class="glass-card">
    <div style="margin-bottom: var(--sp-md);">
        <h4 style="margin: 0 0 12px 0;">Lista de Mascotas</h4>

        <!-- Filtros -->
        <div class="d-flex flex-wrap align-items-end gap-3" style="margin-bottom: 12px;">
            <div style="flex: 1; min-width: 200px;">
                <label class="text-secondary" style="font-size: 0.78rem; margin-bottom: 4px; display: block;">Nombre de mascota o dueño</label>
                <input type="text" @bind-value="searchTerm" @bind-value:after="OnFilterChanged" class="form-control form-control-sm"
                       placeholder="Buscar..."
                       style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;" />
            </div>
            <div style="min-width: 150px;">
                <label class="text-secondary" style="font-size: 0.78rem; margin-bottom: 4px; display: block;">Especie</label>
                <select @bind="filtroEspecie" @bind:after="OnFilterChanged" class="form-select form-select-sm"
                        style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;">
                    <option value="">Todas</option>
                    @if (especiesDisponibles != null)
                    {
                        @foreach (var esp in especiesDisponibles)
                        {
                            <option value="@esp.Nombre">@esp.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div style="min-width: 140px;">
                <label class="text-secondary" style="font-size: 0.78rem; margin-bottom: 4px; display: block;">Estado</label>
                <select @bind="filtroEstado" @bind:after="OnFilterChanged" class="form-select form-select-sm"
                        style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;">
                    <option value="Activo">Activos</option>
                    <option value="Inactivo">Inactivos</option>
                    <option value="">Todos</option>
                </select>
            </div>
            @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(filtroEspecie) || filtroEstado != "Activo")
            {
                <button class="btn btn-sm btn-outline-secondary" style="height: 31px; border-color: var(--border-glass); color: var(--text-secondary);" @onclick="ClearFilters">
                    Limpiar filtros
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <p class="text-secondary">Cargando datos...</p>
    }
    else if (filteredItems == null || !filteredItems.Any())
    {
        <p class="text-secondary">No se encontraron mascotas con los filtros aplicados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="background: transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-glass);">
                        <th>Paciente</th>
                        <th>Especie / Raza</th>
                        <th>Propietario (Dueño)</th>
                        <th>Edad / Sexo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pac in filteredItems)
                    {
                        <tr style="border-bottom: 1px solid var(--border-glass);">
                            <td>
                                <strong>@pac.Nombre</strong>
                            </td>
                            <td>
                                @pac.EspecieNombre
                                @if(!string.IsNullOrEmpty(pac.RazaNombre)) { <br/><small class="text-secondary">@pac.RazaNombre</small> }
                            </td>
                            <td>
                                <a href="/propietarios/editar/@pac.PropietarioId" style="color: var(--accent-primary); text-decoration: none;">@pac.PropietarioNombre</a>
                            </td>
                            <td>
                                @pac.EdadEnAnios años <br/> <small class="text-secondary">@(pac.Sexo == "M" ? "Macho" : pac.Sexo == "H" ? "Hembra" : "Desconocido")</small>
                            </td>
                            <td>
                                @if(pac.Activo) { <span style="color: var(--accent-primary);">Activo</span> }
                                else { <span style="color: var(--accent-danger);">Inactivo</span> }
                            </td>
                            <td class="text-end">
                                <a href="/pacientes/editar/@pac.Id" class="btn btn-sm btn-outline-info" style="border-color: var(--border-glass); color: var(--text-primary);">Editar</a>
                                <button class="btn btn-sm btn-outline-danger" style="margin-left: 5px;" @onclick="() => ConfirmDelete(pac.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-secondary">
                Mostrando @filteredItems.Count de @pacientesResponse?.TotalCount registros
                @if (pacientesResponse != null)
                {
                    <text> (Página @pacientesResponse.PageIndex de @pacientesResponse.TotalPages)</text>
                }
            </span>
            <div>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(pacientesResponse?.HasPreviousPage != true)" @onclick="PreviousPage">Anterior</button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(pacientesResponse?.HasNextPage != true)" @onclick="NextPage">Siguiente</button>
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
        @errorMessage
    </div>
}

@* ═══════ MODAL 1: Nuevo Paciente ═══════ *@
@if (showPacienteModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="ClosePacienteModal" @onclick:stopPropagation="false">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Nuevo Paciente</h3>
                <button class="modal-close-btn" @onclick="ClosePacienteModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @if (isLoadingPacienteModal)
            {
                <p class="text-secondary">Cargando catálogos...</p>
            }
            else
            {
                <EditForm Model="pacienteModel" OnValidSubmit="HandleSavePaciente" FormName="modalPacienteForm">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre de mascota (*)</label>
                            <InputText @bind-Value="pacienteModel.Nombre" class="form-control bg-dark text-light border-secondary" />
                            <ValidationMessage For="@(() => pacienteModel.Nombre)" class="text-danger" />
                        </div>
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Propietario / Dueño (*)</label>
                            <div class="d-flex gap-2">
                                <InputSelect @bind-Value="pacienteModel.PropietarioId" class="form-select bg-dark text-light border-secondary">
                                    <option value="">-- Seleccione un Dueño --</option>
                                    @foreach (var p in modalPropietarios)
                                    {
                                        <option value="@p.Id">@p.NombreCompleto - @p.DNI</option>
                                    }
                                </InputSelect>
                                <button type="button" @onclick="OpenClienteModalFromPaciente" class="btn btn-outline-info d-flex align-items-center" style="white-space: nowrap; border-color: var(--border-glass); color: var(--accent-primary);" title="Registrar nuevo cliente">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                    </svg>
                                    Nuevo
                                </button>
                            </div>
                            <ValidationMessage For="@(() => pacienteModel.PropietarioId)" class="text-danger" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Especie (*)</label>
                            <InputSelect Value="pacienteModel.EspecieId" ValueExpression="()=>pacienteModel.EspecieId" ValueChanged="((int v) => OnModalEspecieChanged(v))" class="form-select bg-dark text-light border-secondary">
                                <option value="0">-- Seleccione Especie --</option>
                                @foreach (var e in modalEspecies)
                                {
                                    <option value="@e.Id">@e.Nombre</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => pacienteModel.EspecieId)" class="text-danger" />
                        </div>
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Raza (*)</label>
                            <InputSelect @bind-Value="pacienteModel.RazaId" class="form-select bg-dark text-light border-secondary" disabled="@(modalRazas.Count == 0)">
                                <option value="">-- Seleccione Raza --</option>
                                @foreach (var r in modalRazas)
                                {
                                    <option value="@r.Id">@r.Nombre</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => pacienteModel.RazaId)" class="text-danger" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Sexo (*)</label>
                            <InputSelect @bind-Value="pacienteModel.Sexo" class="form-select bg-dark text-light border-secondary">
                                <option value="">-- Sexo --</option>
                                <option value="M">Macho</option>
                                <option value="H">Hembra</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => pacienteModel.Sexo)" class="text-danger" />
                        </div>
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nacimiento (*)</label>
                            <InputDate @bind-Value="pacienteModel.FechaNacimiento" class="form-control bg-dark text-light border-secondary" />
                            <ValidationMessage For="@(() => pacienteModel.FechaNacimiento)" class="text-danger" />
                            @if (!string.IsNullOrEmpty(pacienteFechaError))
                            { <div class="text-danger" style="font-size: 0.8rem; margin-top: 4px;">@pacienteFechaError</div> }
                        </div>
                    </div>

                    <div class="row" style="margin-bottom: var(--sp-sm);">
                        <div class="col-12">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Observaciones (Alergias, Condiciones previas...)</label>
                            <InputTextArea @bind-Value="pacienteModel.Observaciones" class="form-control bg-dark text-light border-secondary" rows="3" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(pacienteErrorMessage))
                    {
                        <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                            @pacienteErrorMessage
                        </div>
                    }

                    <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                        <button type="button" class="btn btn-outline-secondary text-light" @onclick="ClosePacienteModal">Cancelar</button>
                        <button type="submit" class="btn-primary-glass" disabled="@isSavingPaciente">
                            @if(isSavingPaciente) { <span>Guardando...</span> } else { <span>Guardar Paciente</span> }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@* ═══════ MODAL 2: Nuevo Cliente (desde Paciente) ═══════ *@
@if (showClienteModal)
{
    <div class="modal-overlay modal-overlay-z2" @onclick="CloseClienteModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Nuevo Cliente</h3>
                <button class="modal-close-btn" @onclick="CloseClienteModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="clienteModel" OnValidSubmit="HandleSaveCliente" FormName="modalClienteFormFromPac">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre (*)</label>
                        <InputText @bind-Value="clienteModel.Nombre" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.Nombre)" class="text-danger" />
                    </div>
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Apellido (*)</label>
                        <InputText @bind-Value="clienteModel.Apellido" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.Apellido)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">DNI (*)</label>
                        <InputText @bind-Value="clienteModel.DNI" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.DNI)" class="text-danger" />
                    </div>
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Celular / Teléfono (*)</label>
                        <InputText @bind-Value="clienteModel.Telefono" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.Telefono)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Correo Electrónico</label>
                        <InputText @bind-Value="clienteModel.Email" type="email" class="form-control bg-dark text-light border-secondary" />
                    </div>
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Dirección Física</label>
                        <InputText @bind-Value="clienteModel.Direccion" class="form-control bg-dark text-light border-secondary" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(clienteErrorMessage))
                {
                    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                        @clienteErrorMessage
                    </div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseClienteModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingCliente">
                        @if(isSavingCliente) { <span>Guardando...</span> } else { <span>Guardar Cliente</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private PaginatedList<PacienteDto>? pacientesResponse;
    private List<PacienteDto>? filteredItems;
    private List<EspecieDto>? especiesDisponibles;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    
    private int currentPage = 1;
    private int pageSize = 50; // Load more to allow client-side filtering
    private string searchTerm = string.Empty;
    private string filtroEspecie = string.Empty;
    private string filtroEstado = "Activo"; // Default: only active

    // ── Modal Nuevo Paciente ──
    private bool showPacienteModal;
    private bool isLoadingPacienteModal;
    private PacienteDto pacienteModel = new();
    private bool isSavingPaciente;
    private string pacienteErrorMessage = string.Empty;
    private string pacienteFechaError = string.Empty;
    private List<PropietarioDto> modalPropietarios = new();
    private List<EspecieDto> modalEspecies = new();
    private List<RazaDto> modalRazas = new();

    // ── Modal Nuevo Cliente (anidado) ──
    private bool showClienteModal;
    private PropietarioDto clienteModel = new();
    private bool isSavingCliente;
    private string clienteErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEspeciesAsync();
        await LoadDataAsync();
    }

    private async Task LoadEspeciesAsync()
    {
        try
        {
            especiesDisponibles = await CatalogoService.GetEspeciesActivasAsync();
        }
        catch { /* ignore */ }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            pacientesResponse = await PacienteService.GetAllAsync(currentPage, pageSize, searchTerm);
            ApplyClientFilters();
        }
        catch (Exception)
        {
            errorMessage = "Error de conexión al cargar pacientes.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyClientFilters()
    {
        if (pacientesResponse?.Items == null)
        {
            filteredItems = null;
            return;
        }

        IEnumerable<PacienteDto> items = pacientesResponse.Items;

        // Filter by Estado
        if (filtroEstado == "Activo")
            items = items.Where(p => p.Activo);
        else if (filtroEstado == "Inactivo")
            items = items.Where(p => !p.Activo);

        // Filter by Especie
        if (!string.IsNullOrEmpty(filtroEspecie))
            items = items.Where(p => p.EspecieNombre == filtroEspecie);

        filteredItems = items.ToList();
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;
        filtroEspecie = string.Empty;
        filtroEstado = "Activo";
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task PreviousPage()
    {
        if (pacientesResponse?.HasPreviousPage == true)
        {
            currentPage--;
            await LoadDataAsync();
        }
    }

    private async Task NextPage()
    {
        if (pacientesResponse?.HasNextPage == true)
        {
            currentPage++;
            await LoadDataAsync();
        }
    }

    private async Task ConfirmDelete(string id)
    {
        bool confirmed = true; 
        if (confirmed)
        {
            var result = await PacienteService.DeleteAsync(id);
            if (result) await LoadDataAsync();
            else errorMessage = "No se pudo eliminar el paciente.";
        }
    }

    // ── Modal Paciente Handlers ──
    private async Task OpenPacienteModal()
    {
        pacienteModel = new PacienteDto();
        pacienteErrorMessage = string.Empty;
        isSavingPaciente = false;
        isLoadingPacienteModal = true;
        showPacienteModal = true;

        try
        {
            var props = await PropietarioService.GetAllActivosAsync();
            if (props != null) modalPropietarios = props;

            var esp = await CatalogoService.GetEspeciesActivasAsync();
            if (esp != null) modalEspecies = esp;

            modalRazas = new List<RazaDto>();
        }
        catch
        {
            pacienteErrorMessage = "Error al cargar catálogos.";
        }
        finally
        {
            isLoadingPacienteModal = false;
        }
    }

    private void ClosePacienteModal()
    {
        showPacienteModal = false;
    }

    private async Task OnModalEspecieChanged(int newEspecieId)
    {
        pacienteModel.EspecieId = newEspecieId;
        pacienteModel.RazaId = null;
        try
        {
            var r = await CatalogoService.GetRazasPorEspecieAsync(newEspecieId);
            modalRazas = r ?? new List<RazaDto>();
        }
        catch
        {
            modalRazas = new List<RazaDto>();
        }
    }

    private async Task HandleSavePaciente()
    {
        isSavingPaciente = true;
        pacienteErrorMessage = string.Empty;
        pacienteFechaError = string.Empty;

        // Validación custom: fecha de nacimiento no puede ser futura
        if (pacienteModel.FechaNacimiento.HasValue && pacienteModel.FechaNacimiento.Value.Date > DateTime.Today)
        {
            pacienteFechaError = "La fecha ingresada es inválida (Es una fecha futura)";
            isSavingPaciente = false;
            return;
        }
        try
        {
            var result = await PacienteService.CreateAsync(pacienteModel);
            if (result.Success)
            {
                showPacienteModal = false;
                await LoadDataAsync();
            }
            else
            {
                pacienteErrorMessage = $"Ocurrió un error al guardar: {result.ErrorMessage}";
            }
        }
        catch (Exception)
        {
            pacienteErrorMessage = "Excepción al guardar los datos.";
        }
        finally
        {
            isSavingPaciente = false;
        }
    }

    // ── Modal Cliente (anidado desde Paciente) ──
    private void OpenClienteModalFromPaciente()
    {
        clienteModel = new PropietarioDto();
        clienteErrorMessage = string.Empty;
        isSavingCliente = false;
        showClienteModal = true;
    }

    private void CloseClienteModal()
    {
        showClienteModal = false;
    }

    private async Task HandleSaveCliente()
    {
        isSavingCliente = true;
        clienteErrorMessage = string.Empty;
        try
        {
            var result = await PropietarioService.CreateAsync(clienteModel);
            if (result)
            {
                // Recargar propietarios y auto-seleccionar el nuevo
                var props = await PropietarioService.GetAllActivosAsync();
                if (props != null)
                {
                    modalPropietarios = props;
                    // Seleccionar el último creado (el nuevo) buscando por DNI
                    var nuevo = props.FirstOrDefault(p => p.DNI == clienteModel.DNI);
                    if (nuevo != null)
                    {
                        pacienteModel.PropietarioId = nuevo.Id;
                    }
                }
                showClienteModal = false;
            }
            else
            {
                clienteErrorMessage = "Ocurrió un error al guardar. Vuelva a intentar.";
            }
        }
        catch (Exception)
        {
            clienteErrorMessage = "Error de conexión al guardar los datos.";
        }
        finally
        {
            isSavingCliente = false;
        }
    }
}
