                </div>
            }
            <div class="d-flex justify-content-end mt-4">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="ClosePropietarioDetailModal">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private PaginatedList<PacienteDto>? pacientesResponse;
    private List<PacienteDto>? filteredItems;
    
    // ── Confirmación de Eliminación ──
    private bool showDeleteConfirmationModal;
    private PacienteDto? pacienteToDelete;
    private List<TurnoDto>? pendingTurnosToDelete;
    private List<EspecieDto>? especiesDisponibles;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    
    private int currentPage = 1;
    private int pageSize = 50; // Load more to allow client-side filtering
    private string searchTerm = string.Empty;
    private string filtroEspecie = string.Empty;
    private string filtroEstado = "Activo"; // Default: only active

    // ── Modal Nuevo Paciente ──
    private bool showPacienteModal;
    private bool isLoadingPacienteModal;
    private PacienteDto pacienteModel = new();
    private bool isSavingPaciente;
    private string pacienteErrorMessage = string.Empty;
    private string pacienteFechaError = string.Empty;
    private List<PropietarioDto> modalPropietarios = new();
    private List<EspecieDto> modalEspecies = new();
    private List<RazaDto> modalRazas = new();

    // ── Modal Nuevo Cliente (anidado) ──
    private bool showClienteModal;
    private PropietarioDto clienteModel = new();
    private bool isSavingCliente;
    private string clienteErrorMessage = string.Empty;

    // ── Modal Especie (anidado) ──
    private bool showEspecieModal;
    private EspecieDto especieModel = new();
    private bool isSavingEspecie;
    private string especieErrorMessage = string.Empty;

    // ── Modal Raza (anidado) ──
    private bool showRazaModal;
    private RazaDto razaModel = new();
    private bool isSavingRaza;
    private string razaErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEspeciesAsync();
        await LoadDataAsync();
    }

    private async Task LoadEspeciesAsync()
    {
        try
        {
            especiesDisponibles = await CatalogoService.GetEspeciesActivasAsync();
        }
        catch { /* ignore */ }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            pacientesResponse = await PacienteService.GetAllAsync(currentPage, pageSize, searchTerm);
            ApplyClientFilters();
        }
        catch (Exception)
        {
            errorMessage = "Error de conexión al cargar pacientes.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyClientFilters()
    {
        if (pacientesResponse?.Items == null)
        {
            filteredItems = null;
            return;
        }

        IEnumerable<PacienteDto> items = pacientesResponse.Items;

        // Filter by Estado
        if (filtroEstado == "Activo")
            items = items.Where(p => p.Activo);
        else if (filtroEstado == "Inactivo")
            items = items.Where(p => !p.Activo);

        // Filter by Especie
        if (!string.IsNullOrEmpty(filtroEspecie))
            items = items.Where(p => p.EspecieNombre == filtroEspecie);

        filteredItems = items.ToList();
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;
        filtroEspecie = string.Empty;
        filtroEstado = "Activo";
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task PreviousPage()
    {
        if (pacientesResponse?.HasPreviousPage == true)
        {
            currentPage--;
            await LoadDataAsync();
        }
    }

    private async Task NextPage()
    {
        if (pacientesResponse?.HasNextPage == true)
        {
            currentPage++;
            await LoadDataAsync();
        }
    }

    private async Task ConfirmDelete(string id)
    {
        pacienteToDelete = filteredItems?.FirstOrDefault(p => p.Id == id);
        if (pacienteToDelete == null) return;

        pendingTurnosToDelete = new List<TurnoDto>();
        try
        {
            var turnos = await TurnoService.GetByPacienteIdAsync(id);
            if (turnos != null)
            {
                pendingTurnosToDelete = turnos.Where(t => 
                    t.Estado == "Programado" || 
                    t.Estado == "Confirmado" || 
                    t.Estado == "Reprogramado" || 
                    t.Estado == "EnCurso"
                ).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al buscar turnos del paciente: {ex.Message}");
        }

        showDeleteConfirmationModal = true;
    }

    private void CloseDeleteConfirmationModal()
    {
        showDeleteConfirmationModal = false;
        pacienteToDelete = null;
        pendingTurnosToDelete = null;
    }

    private async Task ExecuteDelete()
    {
        if (pacienteToDelete == null) return;

        try
        {
            var result = await PacienteService.DeleteAsync(pacienteToDelete.Id);
            if (result)
            {
                await LoadDataAsync();
            }
            else
            {
                errorMessage = "No se pudo eliminar el paciente.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Ocurrió un error al intentar eliminar el paciente.";
        }
        finally
        {
            CloseDeleteConfirmationModal();
        }
    }

    private string GetEdadFormateada(DateTime? fechaNacimiento, int? edadEnAnios)
    {
        if (!fechaNacimiento.HasValue) return "Desconocida";
        var nacimiento = fechaNacimiento.Value.Date;
        var hoy = DateTime.Today;

        if (nacimiento > hoy) return "0 meses";

        int años = hoy.Year - nacimiento.Year;
        int meses = hoy.Month - nacimiento.Month;
        if (hoy.Day < nacimiento.Day)
        {
            meses--;
        }

        if (meses < 0)
        {
            años--;
            meses += 12;
        }

        if (años > 0)
        {
            return $"{años} {(años == 1 ? "año" : "años")}";
        }
        else
        {
            return $"{meses} {(meses == 1 ? "mes" : "meses")}";
        }
    }

    // ── Modal Paciente Handlers ──
    private async Task OpenPacienteModal()
    {
        pacienteModel = new PacienteDto();
        pacienteErrorMessage = string.Empty;
        isSavingPaciente = false;
        isLoadingPacienteModal = true;
        showPacienteModal = true;

        try
        {
            var props = await PropietarioService.GetAllActivosAsync();
            if (props != null) modalPropietarios = props;

            var esp = await CatalogoService.GetEspeciesActivasAsync();
            if (esp != null) modalEspecies = esp;

            modalRazas = new List<RazaDto>();
        }
        catch
        {
            pacienteErrorMessage = "Error al cargar catálogos.";
        }
        finally
        {
            isLoadingPacienteModal = false;
        }
    }

    private void ClosePacienteModal()
    {
        showPacienteModal = false;
    }

    private async Task OnModalEspecieChanged(int newEspecieId)
    {
        pacienteModel.EspecieId = newEspecieId;
        pacienteModel.RazaId = null;
        try
        {
            var r = await CatalogoService.GetRazasPorEspecieAsync(newEspecieId);
            modalRazas = r ?? new List<RazaDto>();
        }
        catch
        {
            modalRazas = new List<RazaDto>();
        }
    }

    private async Task HandleSavePaciente()
    {
        isSavingPaciente = true;
        pacienteErrorMessage = string.Empty;
        pacienteFechaError = string.Empty;

        // Validación custom: fecha de nacimiento no puede ser futura
        if (pacienteModel.FechaNacimiento.HasValue && pacienteModel.FechaNacimiento.Value.Date > DateTime.Today)
        {
            pacienteFechaError = "La fecha ingresada es inválida (Es una fecha futura)";
            isSavingPaciente = false;
            return;
        }
        try
        {
            (bool Success, string ErrorMessage) result;
            if (string.IsNullOrEmpty(pacienteModel.Id))
            {
                result = await PacienteService.CreateAsync(pacienteModel);
            }
            else
            {
                result = await PacienteService.UpdateAsync(pacienteModel.Id, pacienteModel);
            }

            if (result.Success)
            {
                showPacienteModal = false;
                await LoadDataAsync();
            }
            else
            {
                pacienteErrorMessage = $"Ocurrió un error al guardar: {result.ErrorMessage}";
            }
        }
        catch (Exception)
        {
            pacienteErrorMessage = "Excepción al guardar los datos.";
        }
        finally
        {
            isSavingPaciente = false;
        }
    }

    private async Task OpenPacienteModalForEdit(PacienteDto pac)
    {
        pacienteErrorMessage = string.Empty;
        isSavingPaciente = false;
        isLoadingPacienteModal = true;
        showPacienteModal = true;

        try
        {
            var props = await PropietarioService.GetAllActivosAsync();
            if (props != null) modalPropietarios = props;

            var esp = await CatalogoService.GetEspeciesActivasAsync();
            if (esp != null) modalEspecies = esp;

            pacienteModel = new PacienteDto
            {
                Id = pac.Id,
                Nombre = pac.Nombre,
                EspecieId = pac.EspecieId,
                RazaId = pac.RazaId,
                PropietarioId = pac.PropietarioId,
                FechaNacimiento = pac.FechaNacimiento,
                Sexo = pac.Sexo,
                Observaciones = pac.Observaciones,
                Activo = pac.Activo
            };

            if (pac.EspecieId > 0)
            {
                var r = await CatalogoService.GetRazasPorEspecieAsync(pac.EspecieId);
                modalRazas = r ?? new List<RazaDto>();
            }
            else
            {
                modalRazas = new List<RazaDto>();
            }
        }
        catch
        {
            pacienteErrorMessage = "Error al cargar catálogos.";
        }
        finally
        {
            isLoadingPacienteModal = false;
        }
    }

    // Detail popover states
    private bool showPacienteDetailModal;
    private PacienteDto? selectedPacienteDetail;
    private bool showPropietarioDetailModal;
    private PropietarioDto? selectedPropietarioDetail;
    private List<PacienteDto>? selectedPropietarioMascotas;

    private void ClosePacienteDetailModal()
    {
        showPacienteDetailModal = false;
        selectedPacienteDetail = null;
    }

    private void ClosePropietarioDetailModal()
    {
        showPropietarioDetailModal = false;
        selectedPropietarioDetail = null;
        selectedPropietarioMascotas = null;
    }

    private async Task OpenPacienteDetailModal(string pacienteId)
    {
        selectedPacienteDetail = null;
        showPacienteDetailModal = true;
        try
        {
            var pac = await PacienteService.GetByIdAsync(pacienteId);
            if (pac != null) selectedPacienteDetail = pac;
        }
        catch {}
    }

    private async Task OpenPropietarioDetailModal(string propietarioId)
    {
        selectedPropietarioDetail = null;
        selectedPropietarioMascotas = null;
        showPropietarioDetailModal = true;
        try
        {
            var prop = await PropietarioService.GetByIdAsync(propietarioId);
            if (prop != null)
            {
                selectedPropietarioDetail = prop;
                selectedPropietarioMascotas = await PacienteService.GetByPropietarioIdAsync(prop.Id) ?? new List<PacienteDto>();
            }
        }
        catch {}
    }

    private string FormatWhatsApp(string telefono)
    {
        if (string.IsNullOrEmpty(telefono)) return string.Empty;
        var clean = new string(telefono.Where(char.IsDigit).ToArray());
        return clean;
    }

    // ── Modal Cliente (anidado desde Paciente) ──
    private void OpenClienteModalFromPaciente()
    {
        clienteModel = new PropietarioDto();
        clienteErrorMessage = string.Empty;
        isSavingCliente = false;
        showClienteModal = true;
    }

    private void CloseClienteModal()
    {
        showClienteModal = false;
    }

    private async Task HandleSaveCliente()
    {
        isSavingCliente = true;
        clienteErrorMessage = string.Empty;
        try
        {
            var result = await PropietarioService.CreateAsync(clienteModel);
            if (result)
            {
                // Recargar propietarios y auto-seleccionar el nuevo
                var props = await PropietarioService.GetAllActivosAsync();
                if (props != null)
                {
                    modalPropietarios = props;
                    // Seleccionar el último creado (el nuevo) buscando por DNI
                    var nuevo = props.FirstOrDefault(p => p.DNI == clienteModel.DNI);
                    if (nuevo != null)
                    {
                        pacienteModel.PropietarioId = nuevo.Id;
                    }
                }
                showClienteModal = false;
            }
            else
            {
                clienteErrorMessage = "Ocurrió un error al guardar. Vuelva a intentar.";
            }
        }
        catch (Exception)
        {
            clienteErrorMessage = "Error de conexión al guardar los datos.";
        }
        finally
        {
            isSavingCliente = false;
        }
    }

    // ── Modal Especie Handlers ──
    private void OpenEspecieModalFromPaciente()
    {
        especieModel = new EspecieDto();
        especieErrorMessage = string.Empty;
        isSavingEspecie = false;
        showEspecieModal = true;
    }

    private void CloseEspecieModal()
    {
        showEspecieModal = false;
    }

    private async Task HandleSaveEspecie()
    {
        isSavingEspecie = true;
        especieErrorMessage = string.Empty;
        try
        {
            var result = await CatalogoService.CreateEspecieAsync(especieModel);
            if (result)
            {
                var esp = await CatalogoService.GetEspeciesActivasAsync();
                if (esp != null)
                {
                    modalEspecies = esp;
                    especiesDisponibles = esp; // update filters species list too

                    var nuevo = esp.FirstOrDefault(e => e.Nombre.Equals(especieModel.Nombre, StringComparison.OrdinalIgnoreCase));
                    if (nuevo != null)
                    {
                        await OnModalEspecieChanged(nuevo.Id);
                    }
                }
                showEspecieModal = false;
            }
            else
            {
                especieErrorMessage = "Ocurrió un error al guardar. Vuelva a intentar.";
            }
        }
        catch (Exception)
        {
            especieErrorMessage = "Error de conexión al guardar los datos.";
        }
        finally
        {
            isSavingEspecie = false;
        }
    }

    // ── Modal Raza Handlers ──
    private void OpenRazaModalFromPaciente()
    {
        if (pacienteModel.EspecieId == 0) return;
        razaModel = new RazaDto { EspecieId = pacienteModel.EspecieId };
        razaErrorMessage = string.Empty;
        isSavingRaza = false;
        showRazaModal = true;
    }

    private void CloseRazaModal()
    {
        showRazaModal = false;
    }

    private async Task HandleSaveRaza()
    {
        isSavingRaza = true;
        razaErrorMessage = string.Empty;
        try
        {
            var result = await CatalogoService.CreateRazaAsync(razaModel);
            if (result)
            {
                var r = await CatalogoService.GetRazasPorEspecieAsync(pacienteModel.EspecieId);
                modalRazas = r ?? new List<RazaDto>();

                var nuevo = modalRazas.FirstOrDefault(ra => ra.Nombre.Equals(razaModel.Nombre, StringComparison.OrdinalIgnoreCase));
                if (nuevo != null)
                {
                    pacienteModel.RazaId = nuevo.Id;
                }
                showRazaModal = false;
            }
            else
            {
                razaErrorMessage = "Ocurrió un error al guardar. Vuelva a intentar.";
            }
        }
        catch (Exception)
        {
            razaErrorMessage = "Error de conexión al guardar los datos.";
        }
        finally
        {
            isSavingRaza = false;
        }
    }
}
