@page "/pacientes"
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject PacienteService PacienteService
@inject PropietarioService PropietarioService
@inject CatalogoService CatalogoService
@inject NavigationManager Navigation
@inject TurnoService TurnoService

<PageTitle>Mascotas / Pacientes</PageTitle>

<div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
    <div>
        <h2 style="font-weight: 700; margin: 0;">Registro de Pacientes</h2>
        <p class="text-secondary" style="margin: 0;">Gestión de mascotas e información del paciente</p>
    </div>
    <AuthorizeView Roles="Admin,Veterinario,Recepcionista">
        <Authorized>
            <button @onclick="OpenPacienteModal" class="btn-primary-glass" style="display: flex; align-items: center; gap: 8px; border: none; cursor: pointer;">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 20px;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Nuevo Paciente
            </button>
        </Authorized>
    </AuthorizeView>
</div>

<div class="glass-card">
    <div style="margin-bottom: var(--sp-md);">
        <h4 style="margin: 0 0 12px 0;">Lista de Mascotas</h4>

        <!-- Filtros -->
        <div class="d-flex flex-wrap align-items-end gap-3" style="margin-bottom: 12px;">
            <div style="flex: 1; min-width: 200px;">
                <label class="text-secondary" style="font-size: 0.78rem; margin-bottom: 4px; display: block;">Nombre de mascota o dueño</label>
                <input type="text" @bind-value="searchTerm" @bind-value:event="oninput" @bind-value:after="OnFilterChanged" class="form-control form-control-sm"
                       placeholder="Buscar..."
                       style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;" />
            </div>
            <div style="min-width: 150px;">
                <label class="text-secondary" style="font-size: 0.78rem; margin-bottom: 4px; display: block;">Especie</label>
                <select @bind="filtroEspecie" @bind:after="OnFilterChanged" class="form-select form-select-sm"
                        style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;">
                    <option value="">Todas</option>
                    @if (especiesDisponibles != null)
                    {
                        @foreach (var esp in especiesDisponibles)
                        {
                            <option value="@esp.Nombre">@esp.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div style="min-width: 140px;">
                <label class="text-secondary" style="font-size: 0.78rem; margin-bottom: 4px; display: block;">Estado</label>
                <select @bind="filtroEstado" @bind:after="OnFilterChanged" class="form-select form-select-sm"
                        style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;">
                    <option value="Activo">Activos</option>
                    <option value="Inactivo">Inactivos</option>
                    <option value="">Todos</option>
                </select>
            </div>
            @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(filtroEspecie) || filtroEstado != "Activo")
            {
                <button class="btn btn-sm btn-outline-secondary" style="height: 31px; border-color: var(--border-glass); color: var(--text-secondary);" @onclick="ClearFilters">
                    Limpiar filtros
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <p class="text-secondary">Cargando datos...</p>
    }
    else if (filteredItems == null || !filteredItems.Any())
    {
        <p class="text-secondary">No se encontraron mascotas con los filtros aplicados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="background: transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-glass);">
                        <th>Paciente</th>
                        <th>Especie / Raza</th>
                        <th>Propietario (Dueño)</th>
                        <th>Edad / Sexo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pac in filteredItems)
                    {
                        <tr style="border-bottom: 1px solid var(--border-glass);">
                            <td>
                                <strong><button type="button" class="btn btn-link p-0 text-start fw-bold" style="color: var(--text-primary); text-decoration: none; border: none; background: transparent; cursor: pointer;" @onclick="() => OpenPacienteDetailModal(pac.Id)">@pac.Nombre</button></strong>
                            </td>
                            <td>
                                @pac.EspecieNombre
                                @if(!string.IsNullOrEmpty(pac.RazaNombre)) { <br/><small class="text-secondary">@pac.RazaNombre</small> }
                            </td>
                            <td>
                                <button type="button" class="btn btn-link p-0 text-start" style="color: var(--accent-primary); text-decoration: none; border: none; background: transparent; cursor: pointer;" @onclick="() => OpenPropietarioDetailModal(pac.PropietarioId)">@pac.PropietarioNombre</button>
                            </td>
                            <td>
                                @GetEdadFormateada(pac.FechaNacimiento, pac.EdadEnAnios) <br/> <small class="text-secondary">@(pac.Sexo == "M" ? "Macho" : pac.Sexo == "H" ? "Hembra" : "Desconocido")</small>
                            </td>
                            <td>
                                @if(pac.Activo) { <span style="color: var(--accent-primary);">Activo</span> }
                                else { <span style="color: var(--accent-danger);">Inactivo</span> }
                            </td>
                            <td class="text-end">
                                <AuthorizeView Roles="Admin,Veterinario,Recepcionista">
                                    <Authorized>
                                        <button type="button" class="btn btn-sm btn-outline-info" style="border-color: var(--border-glass); color: var(--text-primary);" @onclick="() => OpenPacienteModalForEdit(pac)">Editar</button>
                                        <button class="btn btn-sm btn-outline-danger" style="margin-left: 5px;" @onclick="() => ConfirmDelete(pac.Id)">Eliminar</button>
                                    </Authorized>
                                    <NotAuthorized>
                                        <span class="badge bg-secondary">Solo Lectura</span>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-secondary">
                Mostrando @filteredItems.Count de @pacientesResponse?.TotalCount registros
                @if (pacientesResponse != null)
                {
                    <text> (Página @pacientesResponse.PageIndex de @pacientesResponse.TotalPages)</text>
                }
            </span>
            <div>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(pacientesResponse?.HasPreviousPage != true)" @onclick="PreviousPage">Anterior</button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(pacientesResponse?.HasNextPage != true)" @onclick="NextPage">Siguiente</button>
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
        @errorMessage
    </div>
}

@if (showDeleteConfirmationModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseDeleteConfirmationModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Confirmar Eliminación</h3>
                <button class="modal-close-btn" @onclick="CloseDeleteConfirmationModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div style="margin-top: 15px; margin-bottom: 25px;">
                <p>Está a punto de eliminar a <strong>@pacienteToDelete?.Nombre</strong>, ¿confirmar?</p>
                @if (pendingTurnosToDelete != null && pendingTurnosToDelete.Any())
                {
                    <div class="alert alert-warning" style="background: rgba(245, 158, 11, 0.2); border: 1px solid var(--accent-warning); color: white; font-size: 0.9rem; margin-top: 15px; border-radius: 8px; padding: 12px;">
                        <strong>Turno(s) pendiente(s) detectado(s):</strong>
                        <ul style="margin: 8px 0 0 0; padding-left: 20px; font-size: 0.85rem;">
                            @foreach (var t in pendingTurnosToDelete)
                            {
                                <li>
                                    '<strong>@pacienteToDelete?.Nombre</strong>' tiene un turno pendiente con '<strong>@t.VeterinarioNombre</strong>' el '<strong>@t.FechaHora.ToString("dd/MM/yyyy")</strong>' a las '<strong>@t.FechaHora.ToString("HH:mm")</strong>'
                                </li>
                            }
                        </ul>
                        <p style="margin: 10px 0 0 0; font-size: 0.8rem; color: #fcd34d;">
                            * Si continúa, el turno se eliminará también.
                        </p>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-end" style="gap: 10px;">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseDeleteConfirmationModal">No</button>
                <button type="button" class="btn btn-danger" style="background: var(--accent-danger); border: none;" @onclick="ExecuteDelete">Si</button>
            </div>
        </div>
    </div>
}

@* ═══════ MODAL 1: Nuevo Paciente ═══════ *@
@if (showPacienteModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="ClosePacienteModal" @onclick:stopPropagation="false">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Nuevo Paciente</h3>
                <button class="modal-close-btn" @onclick="ClosePacienteModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @if (isLoadingPacienteModal)
            {
                <p class="text-secondary">Cargando catálogos...</p>
            }
            else
            {
                <EditForm Model="pacienteModel" OnValidSubmit="HandleSavePaciente" FormName="modalPacienteForm">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre de mascota (*)</label>
                            <InputText @bind-Value="pacienteModel.Nombre" class="form-control bg-dark text-light border-secondary" />
                            <ValidationMessage For="@(() => pacienteModel.Nombre)" class="text-danger" />
                        </div>
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Propietario / Dueño (*)</label>
                            <div class="d-flex gap-2">
                                <InputSelect @bind-Value="pacienteModel.PropietarioId" class="form-select bg-dark text-light border-secondary">
                                    <option value="">-- Seleccione un Dueño --</option>
                                    @foreach (var p in modalPropietarios)
                                    {
                                        <option value="@p.Id">@p.NombreCompleto - @p.DNI</option>
                                    }
                                </InputSelect>
                                <button type="button" @onclick="OpenClienteModalFromPaciente" class="btn btn-outline-info d-flex align-items-center" style="white-space: nowrap; border-color: var(--border-glass); color: var(--accent-primary);" title="Registrar nuevo cliente">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                    </svg>
                                    Nuevo
                                </button>
                            </div>
                            <ValidationMessage For="@(() => pacienteModel.PropietarioId)" class="text-danger" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Especie (*)</label>
                            <div class="d-flex gap-2">
                                <InputSelect Value="pacienteModel.EspecieId" ValueExpression="()=>pacienteModel.EspecieId" ValueChanged="((int v) => OnModalEspecieChanged(v))" class="form-select bg-dark text-light border-secondary">
                                    <option value="0">-- Seleccione Especie --</option>
                                    @foreach (var e in modalEspecies)
                                    {
                                        <option value="@e.Id">@e.Nombre</option>
                                    }
                                </InputSelect>
                                <button type="button" @onclick="OpenEspecieModalFromPaciente" class="btn btn-outline-info d-flex align-items-center" style="white-space: nowrap; border-color: var(--border-glass); color: var(--accent-primary);" title="Registrar nueva especie">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                    </svg>
                                    Nuevo
                                </button>
                            </div>
                            <ValidationMessage For="@(() => pacienteModel.EspecieId)" class="text-danger" />
                        </div>
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Raza (*)</label>
                            <div class="d-flex gap-2">
                                <InputSelect @bind-Value="pacienteModel.RazaId" class="form-select bg-dark text-light border-secondary" disabled="@(pacienteModel.EspecieId == 0)">
                                    <option value="">-- Seleccione Raza --</option>
                                    @foreach (var r in modalRazas)
                                    {
                                        <option value="@r.Id">@r.Nombre</option>
                                    }
                                </InputSelect>
                                <button type="button" @onclick="OpenRazaModalFromPaciente" class="btn btn-outline-info d-flex align-items-center" style="white-space: nowrap; border-color: var(--border-glass); color: var(--accent-primary);" title="Registrar nueva raza" disabled="@(pacienteModel.EspecieId == 0)">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                    </svg>
                                    Nuevo
                                </button>
                            </div>
                            <ValidationMessage For="@(() => pacienteModel.RazaId)" class="text-danger" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Sexo (*)</label>
                            <InputSelect @bind-Value="pacienteModel.Sexo" class="form-select bg-dark text-light border-secondary">
                                <option value="">-- Sexo --</option>
                                <option value="M">Macho</option>
                                <option value="H">Hembra</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => pacienteModel.Sexo)" class="text-danger" />
                        </div>
                        <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nacimiento (*)</label>
                            <InputDate @bind-Value="pacienteModel.FechaNacimiento" class="form-control bg-dark text-light border-secondary" />
                            <ValidationMessage For="@(() => pacienteModel.FechaNacimiento)" class="text-danger" />
                            @if (!string.IsNullOrEmpty(pacienteFechaError))
                            { <div class="text-danger" style="font-size: 0.8rem; margin-top: 4px;">@pacienteFechaError</div> }
                        </div>
                    </div>

                    <div class="row" style="margin-bottom: var(--sp-sm);">
                        <div class="col-12">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Observaciones (Alergias, Condiciones previas...)</label>
                            <InputTextArea @bind-Value="pacienteModel.Observaciones" class="form-control bg-dark text-light border-secondary" rows="3" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(pacienteErrorMessage))
                    {
                        <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                            @pacienteErrorMessage
                        </div>
                    }

                    <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                        <button type="button" class="btn btn-outline-secondary text-light" @onclick="ClosePacienteModal">Cancelar</button>
                        <button type="submit" class="btn-primary-glass" disabled="@isSavingPaciente">
                            @if(isSavingPaciente) { <span>Guardando...</span> } else { <span>@(string.IsNullOrEmpty(pacienteModel.Id) ? "Guardar Paciente" : "Guardar Cambios")</span> }
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@* ═══════ MODAL 2: Nuevo Cliente (desde Paciente) ═══════ *@
@if (showClienteModal)
{
    <div class="modal-overlay modal-overlay-z2" @onclick="CloseClienteModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Nuevo Cliente</h3>
                <button class="modal-close-btn" @onclick="CloseClienteModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="clienteModel" OnValidSubmit="HandleSaveCliente" FormName="modalClienteFormFromPac">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre (*)</label>
                        <InputText @bind-Value="clienteModel.Nombre" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.Nombre)" class="text-danger" />
                    </div>
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Apellido (*)</label>
                        <InputText @bind-Value="clienteModel.Apellido" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.Apellido)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">DNI (*)</label>
                        <InputText @bind-Value="clienteModel.DNI" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.DNI)" class="text-danger" />
                    </div>
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Celular / Teléfono (*)</label>
                        <InputText @bind-Value="clienteModel.Telefono" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.Telefono)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Correo Electrónico</label>
                        <InputText @bind-Value="clienteModel.Email" type="email" class="form-control bg-dark text-light border-secondary" />
                    </div>
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Dirección Física</label>
                        <InputText @bind-Value="clienteModel.Direccion" class="form-control bg-dark text-light border-secondary" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(clienteErrorMessage))
                {
                    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                        @clienteErrorMessage
                    </div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseClienteModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingCliente">
                        @if(isSavingCliente) { <span>Guardando...</span> } else { <span>Guardar Cliente</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ═══════ MODAL 3: Nueva Especie (desde Paciente) ═══════ *@
@if (showEspecieModal)
{
    <div class="modal-overlay modal-overlay-z2" @onclick="CloseEspecieModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Nueva Especie</h3>
                <button class="modal-close-btn" @onclick="CloseEspecieModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="especieModel" OnValidSubmit="HandleSaveEspecie" FormName="modalEspecieFormFromPac">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre (*)</label>
                        <InputText @bind-Value="especieModel.Nombre" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => especieModel.Nombre)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Descripción</label>
                        <InputText @bind-Value="especieModel.Descripcion" class="form-control bg-dark text-light border-secondary" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(especieErrorMessage))
                {
                    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                        @especieErrorMessage
                    </div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseEspecieModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingEspecie">
                        @if(isSavingEspecie) { <span>Guardando...</span> } else { <span>Guardar Especie</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ═══════ MODAL 4: Nueva Raza (desde Paciente) ═══════ *@
@if (showRazaModal)
{
    <div class="modal-overlay modal-overlay-z2" @onclick="CloseRazaModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Nueva Raza</h3>
                <button class="modal-close-btn" @onclick="CloseRazaModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="razaModel" OnValidSubmit="HandleSaveRaza" FormName="modalRazaFormFromPac">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Especie (*)</label>
                        <InputSelect @bind-Value="razaModel.EspecieId" class="form-select bg-dark text-light border-secondary" disabled="true">
                            @foreach (var e in modalEspecies)
                            {
                                <option value="@e.Id">@e.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre (*)</label>
                        <InputText @bind-Value="razaModel.Nombre" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => razaModel.Nombre)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Descripción</label>
                        <InputText @bind-Value="razaModel.Descripcion" class="form-control bg-dark text-light border-secondary" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(razaErrorMessage))
                {
                    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                        @razaErrorMessage
                    </div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseRazaModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingRaza">
                        @if(isSavingRaza) { <span>Guardando...</span> } else { <span>Guardar Raza</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ═══════ MODAL 5: Detalle Paciente ═══════ *@
@if (showPacienteDetailModal)
{
    <div class="modal-overlay modal-overlay-z2" @onclick="ClosePacienteDetailModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Detalle de Paciente</h3>
                <button class="modal-close-btn" @onclick="ClosePacienteDetailModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            @if (selectedPacienteDetail == null)
            {
                <p class="text-secondary">Cargando...</p>
            }
            else
            {
                <div class="mt-3">
                    <p><strong>Nombre:</strong> @selectedPacienteDetail.Nombre</p>
                    <p><strong>Especie:</strong> @selectedPacienteDetail.EspecieNombre</p>
                    <p><strong>Raza:</strong> @selectedPacienteDetail.RazaNombre</p>
                    <p><strong>Sexo:</strong> @(selectedPacienteDetail.Sexo == "M" ? "Macho" : "Hembra")</p>
                    <p><strong>Nacimiento:</strong> @(selectedPacienteDetail.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</p>
                    <p><strong>Observaciones:</strong> @(string.IsNullOrEmpty(selectedPacienteDetail.Observaciones) ? "Ninguna" : selectedPacienteDetail.Observaciones)</p>
                </div>
            }
            <div class="d-flex justify-content-end mt-4">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="ClosePacienteDetailModal">Cerrar</button>
            </div>
        </div>
    </div>
}

@* ═══════ MODAL 6: Detalle Propietario ═══════ *@
@if (showPropietarioDetailModal)
{
    <div class="modal-overlay modal-overlay-z2" @onclick="ClosePropietarioDetailModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Detalle de Dueño</h3>
                <button class="modal-close-btn" @onclick="ClosePropietarioDetailModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            @if (selectedPropietarioDetail == null)
            {
                <p class="text-secondary">Cargando...</p>
            }
            else
            {
                <div class="mt-3">
                    <p><strong>Nombre Completo:</strong> @selectedPropietarioDetail.NombreCompleto</p>
                    <p><strong>DNI:</strong> @selectedPropietarioDetail.DNI</p>
                    <p><strong>Teléfono:</strong> @selectedPropietarioDetail.Telefono</p>
                    <p><strong>Email:</strong> @selectedPropietarioDetail.Email</p>
                    <p><strong>Dirección:</strong> @(string.IsNullOrEmpty(selectedPropietarioDetail.Direccion) ? "Sin dirección" : selectedPropietarioDetail.Direccion)</p>
                    <div class="d-flex gap-2 mt-3 mb-3">
                        <a href="https://wa.me/@FormatWhatsApp(selectedPropietarioDetail.Telefono)" target="_blank" class="btn btn-success btn-sm d-flex align-items-center gap-2" style="background-color: #25D366; border: none; font-weight: 600; color: white;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-whatsapp" viewBox="0 0 16 16">
                                <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.949h.004c4.368 0 7.926-3.562 7.928-7.929a7.89 7.89 0 0 0-2.33-5.69m-5.61 10.744h-.01a6.5 6.5 0 0 1-3.3-1.02l-.242-.144-2.454.644.656-2.387-.156-.25a6.5 6.5 0 0 1-1.007-3.5C.029 4.348 3.52 1.052 7.99 1.052a6.5 6.5 0 0 1 4.59 1.93(6.5 6.5 0 0 1 1.922 4.6c-.004 4.475-3.498 7.969-7.965 7.969m3.636-4.708c-.18-.089-1.08-.534-1.25-.597-.17-.061-.29-.092-.41.09-.12.18-.46.597-.56.711-.1.115-.2.13-.38.041-1.81-.9-3.236-2.225-4.088-3.727-.12-.206-.013-.319.09-.422.09-.09.18-.21.28-.31.09-.1.12-.17.18-.29.06-.12.03-.22-.01-.31-.04-.09-.41-1.005-.56-1.373-.15-.356-.3-.3-.41-.3-.1-.005-.22-.005-.34-.005-.12 0-.32.045-.49.23-.17.19-.66.645-.66 1.57s.68 1.835.77 1.962c.09.13 1.34 2.044 3.25 2.87.45.2 1.01.32 1.37.43.46.15.88.13 1.21.08.37-.06 1.08-.44 1.23-.863.15-.42.15-.78.1-.863-.05-.08-.18-.12-.36-.21"/>
                            </svg> WhatsApp
                        </a>
                        @if (!string.IsNullOrEmpty(selectedPropietarioDetail.Email))
                        {
                            <a href="mailto:@selectedPropietarioDetail.Email" target="_blank" onclick="window.open(this.href, '_blank'); return false;" class="btn btn-outline-info btn-sm d-flex align-items-center gap-2" style="color: white; border-color: var(--border-glass);">
                                Enviar Correo
                            </a>
                        }
                    </div>
                    <p><strong>Mascotas:</strong></p>
                    @if (selectedPropietarioMascotas == null)
                    {
                        <span class="text-secondary">Cargando mascotas...</span>
                    }
                    else if (!selectedPropietarioMascotas.Any())
                    {
                        <span class="text-secondary">Sin mascotas registradas.</span>
                    }
                    else
                    {
                        <ul>
                            @foreach (var m in selectedPropietarioMascotas)
                            {
                                <li>@m.Nombre (@m.EspecieNombre - @m.RazaNombre)</li>
