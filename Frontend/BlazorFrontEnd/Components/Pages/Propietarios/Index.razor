@page "/propietarios"
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject PropietarioService PropietarioService
@inject NavigationManager Navigation

<PageTitle>Clientes / Propietarios</PageTitle>

<div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
    <div>
        <h2 style="font-weight: 700; margin: 0;">Directorio de Clientes</h2>
        <p class="text-secondary" style="margin: 0;">Gestión de propietarios de mascotas</p>
    </div>
    <button @onclick="OpenClienteModal" class="btn-primary-glass" style="display: flex; align-items: center; gap: 8px; border: none; cursor: pointer;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 20px;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nuevo Cliente
    </button>
</div>

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2" style="margin-bottom: var(--sp-md);">
        <h4 style="margin: 0;">Lista de Clientes</h4>
        <div class="d-flex gap-2">
            <input type="text" @bind="searchTerm" @bind:after="OnSearchChanged" class="form-control" placeholder="Buscar por DNI o Apellido..." style="width: 300px;" />
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearSearch" title="Limpiar filtro">
                    Limpiar
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <p class="text-secondary">Cargando datos...</p>
    }
    else if (propietariosResponse?.Items == null || !propietariosResponse.Items.Any())
    {
        <p class="text-secondary">No se encontraron clientes.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="background: transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-glass);">
                        <th>Nombre Completo</th>
                        <th>DNI</th>
                        <th>Teléfono</th>
                        <th>Mascotas</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prop in propietariosResponse.Items)
                    {
                        <tr style="border-bottom: 1px solid var(--border-glass);">
                            <td>
                                <strong>@prop.NombreCompleto</strong>
                                <br/><small class="text-secondary">@prop.Email</small>
                            </td>
                            <td>@prop.DNI</td>
                            <td>@prop.Telefono</td>
                            <td>
                                <span style="background: var(--accent-secondary); color: white; padding: 2px 8px; border-radius: 12px; font-size: 0.8rem;">
                                    @prop.CantidadMascotas
                                </span>
                            </td>
                            <td>
                                @if(prop.Activo) { <span style="color: var(--accent-primary);">Activo</span> }
                                else { <span style="color: var(--accent-danger);">Inactivo</span> }
                            </td>
                            <td class="text-end">
                                <a href="/propietarios/editar/@prop.Id" class="btn btn-sm btn-outline-info" style="border-color: var(--border-glass); color: var(--text-primary);">Editar</a>
                                <button class="btn btn-sm btn-outline-danger" style="margin-left: 5px;" @onclick="() => ConfirmDelete(prop.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-secondary">Página @propietariosResponse.PageIndex de @propietariosResponse.TotalPages (@propietariosResponse.TotalCount registros)</span>
            <div>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!propietariosResponse.HasPreviousPage)" @onclick="PreviousPage">Anterior</button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!propietariosResponse.HasNextPage)" @onclick="NextPage">Siguiente</button>
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
        @errorMessage
    </div>
}

@* ═══════ MODAL: Nuevo Cliente ═══════ *@
@if (showClienteModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseClienteModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Nuevo Cliente</h3>
                <button class="modal-close-btn" @onclick="CloseClienteModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="clienteModel" OnValidSubmit="HandleSaveCliente" FormName="modalClienteForm">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre (*)</label>
                        <InputText @bind-Value="clienteModel.Nombre" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.Nombre)" class="text-danger" />
                    </div>
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Apellido (*)</label>
                        <InputText @bind-Value="clienteModel.Apellido" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.Apellido)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">DNI (*)</label>
                        <InputText @bind-Value="clienteModel.DNI" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.DNI)" class="text-danger" />
                    </div>
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Celular / Teléfono (*)</label>
                        <InputText @bind-Value="clienteModel.Telefono" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => clienteModel.Telefono)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Correo Electrónico</label>
                        <InputText @bind-Value="clienteModel.Email" type="email" class="form-control bg-dark text-light border-secondary" />
                    </div>
                    <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Dirección Física</label>
                        <InputText @bind-Value="clienteModel.Direccion" class="form-control bg-dark text-light border-secondary" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(clienteErrorMessage))
                {
                    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                        @clienteErrorMessage
                    </div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseClienteModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingCliente">
                        @if(isSavingCliente) { <span>Guardando...</span> } else { <span>Guardar Cliente</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private PaginatedList<PropietarioDto>? propietariosResponse;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    
    private int currentPage = 1;
    private int pageSize = 10;
    private string searchTerm = string.Empty;

    // ── Modal Nuevo Cliente ──
    private bool showClienteModal;
    private PropietarioDto clienteModel = new();
    private bool isSavingCliente;
    private string clienteErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            propietariosResponse = await PropietarioService.GetAllAsync(currentPage, pageSize, searchTerm);
        }
        catch (Exception)
        {
            errorMessage = "Error de conexión al cargar clientes.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchChanged()
    {
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task PreviousPage()
    {
        if (propietariosResponse?.HasPreviousPage == true)
        {
            currentPage--;
            await LoadDataAsync();
        }
    }

    private async Task NextPage()
    {
        if (propietariosResponse?.HasNextPage == true)
        {
            currentPage++;
            await LoadDataAsync();
        }
    }

    private async Task ConfirmDelete(string id)
    {
        // Ideally show a modal, but for simplicity we'll logic here or use JS interop
        // Implementación rápida de borrado para el CRUD
        bool confirmed = true; // In real life: await JS.InvokeAsync<bool>("confirm", "Seguro?");
        if (confirmed)
        {
            var result = await PropietarioService.DeleteAsync(id);
            if (result)
                await LoadDataAsync();
            else
                errorMessage = "No se pudo eliminar el cliente.";
        }
    }

    // ── Modal Handlers ──
    private void OpenClienteModal()
    {
        clienteModel = new PropietarioDto();
        clienteErrorMessage = string.Empty;
        isSavingCliente = false;
        showClienteModal = true;
    }

    private void CloseClienteModal()
    {
        showClienteModal = false;
    }

    private async Task HandleSaveCliente()
    {
        isSavingCliente = true;
        clienteErrorMessage = string.Empty;
        try
        {
            var result = await PropietarioService.CreateAsync(clienteModel);
            if (result)
            {
                showClienteModal = false;
                await LoadDataAsync();
            }
            else
            {
                clienteErrorMessage = "Ocurrió un error al guardar. Vuelva a intentar.";
            }
        }
        catch (Exception)
        {
            clienteErrorMessage = "Error de conexión al guardar los datos.";
        }
        finally
        {
            isSavingCliente = false;
        }
    }
}
